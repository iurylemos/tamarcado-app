# WhatsApp Business Cloud API (Meta) — NUNCA commite valores reais.
# Em produção use `firebase functions:secrets:set` ou um arquivo functions/.env.<projectId> ignorado pelo git.

# Provedor: "whatsapp-cloud-api" (produção) | "emulator-test-double" (somente emulador)
WHATSAPP_PROVIDER=emulator-test-double

# Credenciais do app (Meta for Developers > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Webhook (URL: https://southamerica-east1-<projectId>.cloudfunctions.net/whatsappCloudWebhook)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Segredo do webhook legado de status (providerWebhook)
WHATSAPP_WEBHOOK_SECRET=

# Nomes dos templates aprovados na Meta
WHATSAPP_TEMPLATE_CUSTOMER=appointment_customer_update
WHATSAPP_TEMPLATE_COLLABORATOR=appointment_collaborator_request

# URL pública do painel do colaborador (o template de botão URL deve apontar para <URL>/appointments/{{1}})
COLLABORATOR_APP_URL=http://localhost:5174
