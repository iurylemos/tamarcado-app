{
  "name": "tamarcado",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "collaborator",
    "backoffice",
    "functions"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:functions": "npm run build --workspace functions",
    "build:hosting": "npm run build --workspaces client collaborator backoffice",
    "dev:client": "npm run dev --workspace client",
    "dev:collaborator": "npm run dev --workspace collaborator",
    "dev:backoffice": "npm run dev --workspace backoffice",
    "dev:emulators": "firebase emulators:start --project demo-tamarcado --only auth,firestore,functions,hosting",
    "emulators": "firebase emulators:start --project tamarcado-dad82 --only auth,firestore,functions,hosting",
    "seed:emulator": "npm run seed:emulator --workspace functions",
    "seed:production": "npm run seed:production --workspace functions --",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --project demo-tamarcado --only firestore \"npm run test --workspace functions\"",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "deploy": "npm run build && firebase deploy",
    "deploy:functions": "npm run build:functions && firebase deploy --project tamarcado-dad82 --only functions",
    "deploy:hosting": "npm run build:hosting && firebase deploy --project tamarcado-dad82 --only hosting",
    "deploy:all": "npm run build && firebase deploy --project tamarcado-dad82 --only firestore,functions,hosting"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "firebase-tools": "^15.32.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.4.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
