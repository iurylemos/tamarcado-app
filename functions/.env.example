# Twilio WhatsApp Sandbox — use apenas para desenvolvimento/testes.
# Em produção use Firebase secrets ou um arquivo functions/.env.<projectId> ignorado pelo git.

# Provedor: "twilio" (Sandbox) | "emulator-test-double" (somente emulador)
WHATSAPP_PROVIDER=emulator-test-double

# Credenciais da conta Twilio e número Sandbox exibidos no Twilio Console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Opcional: callback de status (configure como callback no Twilio).
TWILIO_WHATSAPP_STATUS_CALLBACK_URL=https://southamerica-east1-<projectId>.cloudfunctions.net/providerWebhook

# URL pública do painel usado nas mensagens para colaboradores.
COLLABORATOR_APP_URL=http://localhost:5174

# Usado para rodar a seed de produção
VITE_FIREBASE_STORAGE_BUCKET='tamarcado-dad82.firebasestorage.app'
OPENROUTER_API_KEY='sk-tamarcado-v1'
TAVILY_API_KEY="sk-tamarcado-v1"