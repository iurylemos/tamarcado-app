rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeTenantMember(tenantId) {
      return signedIn()
        && request.auth.token.tenantId == tenantId
        && request.auth.token.active == true;
    }

    function activeCollaborator(tenantId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return activeTenantMember(tenantId)
        && request.auth.token.role == 'collaborator'
        && exists(userPath)
        && get(userPath).data.active == true
        && get(userPath).data.tenantId == tenantId
        && get(userPath).data.role == 'collaborator'
        && get(userPath).data.get('professionalId', null)
          == request.auth.token.get('professionalId', null);
    }

    match /public_businesses/{businessId} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    match /public_products/{productId} {
      allow read: if resource.data.published == true && resource.data.active == true;
      allow write: if false;
    }

    match /public_product_galleries/{galleryId} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    match /tenants/{tenantId} {
      allow read, write: if false;
    }

    match /appointments/{appointmentId} {
      allow get, list: if activeCollaborator(resource.data.tenantId)
        && (!request.auth.token.keys().hasAny(['professionalId'])
          || resource.data.professionalId == request.auth.token.professionalId);
      allow write: if false;
    }

    match /connections/{id} {
      allow read: if activeCollaborator(resource.data.tenantId);
      allow write: if false;
    }

    match /contacts/{id} {
      allow read: if activeCollaborator(resource.data.tenantId);
      allow write: if false;
    }

    match /messages/{id} {
      allow read: if activeCollaborator(resource.data.tenantId);
      allow write: if false;
    }

    match /{collection}/{documentId} {
      allow read, write: if false;
    }
  }
}