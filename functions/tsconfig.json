{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "paths": {
      "@shared/*": ["../shared/domain/*"]
    },
    "rootDir": "..",
    "outDir": "lib",
    "types": ["node"],
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../shared/domain/**/*.ts",
    "../client/src/entry-server.tsx",
    "../client/src/interfaces/company.interface.ts",
    "../client/src/components/templates/CompanyCatalogTemplate/**/*.tsx",
    "../client/src/components/organisms/PwaInstallPrompt/**/*.tsx",
    "../client/src/components/molecules/SkeletonCard/**/*.tsx",
    "../client/src/components/atoms/Skeleton/**/*.tsx",
    "../client/src/services/pwa-manifest.service.ts",
    "../client/src/utils/business-slug.util.ts"
  ],
  "exclude": ["../client/src/**/*.spec.ts", "../client/src/**/*.spec.tsx"]
}
